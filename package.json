{
  "name": "lycoboai",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.13.0 <25",
    "pnpm": ">=10.34.7 <11"
  },
  "scripts": {
    "dev": "pnpm cloudflare:dev:setup && pnpm --parallel --filter @lycoboai/web --filter @lycoboai/api dev",
    "dev:worker": "pnpm --filter @lycoboai/worker dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -p tsconfig.tools.json --noEmit && pnpm -r typecheck",
    "lint": "biome check . && node scripts/check-boundaries.mjs && node scripts/check-ui-conventions.mjs",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/foundation.spec.ts tests/e2e/login-history-sync.spec.ts tests/e2e/session-renewal.spec.ts tests/e2e/generation-live.spec.ts tests/e2e/shell-navigation.spec.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:release": "pnpm check && pnpm test:e2e",
    "db:generate": "pnpm --filter @lycoboai/db db:generate",
    "db:migrate": "pnpm --filter @lycoboai/db db:migrate",
    "db:migrate:supabase": "pnpm --filter @lycoboai/db db:migrate:supabase",
    "infra:up": "docker compose up -d --wait postgres",
    "infra:down": "docker compose down",
    "prepare": "node scripts/setup-hooks.mjs",
    "test:integration": "pnpm --filter @lycoboai/worker test:integration && pnpm --filter @lycoboai/worker test:images && pnpm --filter @lycoboai/api test:auth && pnpm --filter @lycoboai/api test:events && pnpm test:cloudflare",
    "cloudflare:deploy": "node --env-file-if-exists=.env scripts/cloudflare/deploy.mjs",
    "cloudflare:setup": "node --env-file-if-exists=.env scripts/cloudflare/setup.mjs",
    "test:cloudflare": "pnpm --filter @lycoboai/worker exec tsx scripts/check-cloudflare-runtime.ts",
    "cloudflare:dev:setup": "node --env-file-if-exists=.env scripts/cloudflare/dev-setup.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261023.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "lint-staged": "17.6.0",
    "miniflare": "5.20261019.2-beta",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.152.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,css}": "biome check --write --no-errors-on-unmatched"
  }
}
