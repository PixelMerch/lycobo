{
  "name": "lycoboai",
  "version": "0.4.26",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.13.0 <25",
    "pnpm": ">=10.34.7 <11"
  },
  "scripts": {
    "dev": "node scripts/local/dev.mjs",
    "dev:worker": "pnpm --filter @lycoboai/worker dev",
    "build": "pnpm -r --if-present build && pnpm cf:build",
    "typecheck": "tsc -p tsconfig.tools.json --noEmit && pnpm -r typecheck",
    "lint": "biome check . --diagnostic-level=warn --error-on-warnings && node scripts/check-boundaries.mjs && node scripts/check-ui-conventions.mjs && node scripts/check-ui-text.mjs && node scripts/check-code-quality.mjs && node scripts/check-code-comments.mjs && pnpm docs:check",
    "quality:update": "node scripts/check-code-quality.mjs --update",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:release": "pnpm check",
    "db:generate": "pnpm --filter @lycoboai/db db:generate",
    "db:migrate": "pnpm --filter @lycoboai/db db:migrate",
    "db:migrate:supabase": "pnpm --filter @lycoboai/db db:migrate:supabase",
    "infra:up": "docker compose up -d --wait postgres image-storage",
    "infra:down": "docker compose down",
    "prepare": "node scripts/setup-hooks.mjs",
    "test:integration": "pnpm --filter @lycoboai/worker test:integration && pnpm --filter @lycoboai/worker test:images && pnpm --filter @lycoboai/api test:auth && pnpm --filter @lycoboai/api test:events",
    "cf:types": "wrangler types worker-configuration.d.ts --env-interface CloudflareEnv --include-runtime=false --strict-vars=false",
    "cf:build": "pnpm cf:build:web && pnpm cf:build:images",
    "dev:cloudflare": "wrangler dev",
    "test:cloudflare": "node scripts/check-cloudflare-runtime.mjs",
    "cf:build:web": "wrangler deploy --config wrangler.jsonc --dry-run --outdir dist-cloudflare/web",
    "cf:build:images": "wrangler deploy --config wrangler.images.jsonc --dry-run --outdir dist-cloudflare/images",
    "dev:cloudflare:images": "wrangler dev --config wrangler.images.jsonc",
    "cf:check:config": "node --env-file-if-exists=.env.cloudflare scripts/check-cloudflare-config.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "ai:context": "node scripts/ai-context.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cloudflare/workers-types": "5.20261108.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "24.19.2",
    "lint-staged": "17.6.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,css}": [
      "biome check --write --no-errors-on-unmatched --diagnostic-level=warn --error-on-warnings",
      "node scripts/check-code-quality.mjs",
      "node scripts/check-code-comments.mjs"
    ]
  }
}
