{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lycobo",
  "main": "apps/api/src/cloudflare.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/images/*"]
  },
  "placement": {
    "region": "aws:ap-southeast-1"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    },
    "redact_query_string": true
  },
  "vars": {
    "AUTH_TRUSTED_ORIGINS": "https://lycobo.com",
    "SUPABASE_AUTH_URL": "https://uyfgzmqijdsesnlsiwqu.supabase.co",
    "SUPABASE_AUTH_PROVIDERS": "google,apple",
    "ASSET_ALLOWED_ORIGINS": "https://lycobo.com",
    "ASSET_PUBLIC_ORIGIN": "https://media.lycobo.com",
    "ASSET_PATH_PREFIX": "/images/",
    "STANDALONE_MODELS": "true",
    "IMAGE_WEBHOOK_ENABLED": "true",
    "CLOUDFLARE_GENERATION_ENABLED": "true",
    "CREEM_MODERATION_ENABLED": "true",
    "BILLING_PROVIDER": "creem",
    "CLOUDFLARE_CONSUMER_ENABLED": "true",
    "CLOUDFLARE_TASKS_SINCE": "2026-11-06T02:05:11.556Z"
  },
  "secrets": {
    "required": [
      "AUTH_JWT_SECRET",
      "AUTH_PASSWORD_TURNSTILE_SITE_KEY",
      "AUTH_PASSWORD_TURNSTILE_SECRET",
      "ASSET_SIGNING_SECRET",
      "STANDALONE_IMAGE_API_KEY",
      "DEEPSEEK_API_KEY",
      "IMAGE_WEBHOOK_SECRET"
    ]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "lycobo-media-prod"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "7ce66ede4e634fab8dc16240a6cedb6c"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "IMAGE_QUEUE",
        "queue": "lycobo-images"
      }
    ]
  },
  "account_id": "9a65fad90669d9c27b58d856ab3ce410",
  "routes": [
    {
      "pattern": "lycobo.com",
      "custom_domain": true
    },
    {
      "pattern": "media.lycobo.com",
      "custom_domain": true
    }
  ],
  "migrations": [
    {
      "tag": "realtime-v1",
      "new_sqlite_classes": ["RealtimeHub"]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME",
        "class_name": "RealtimeHub"
      }
    ]
  }
}
