{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lycobo-assets",
  "account_id": "9a65fad90669d9c27b58d856ab3ce410",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true
    },
    "redact_query_string": true
  },
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "lycobo"
    }
  ]
}
