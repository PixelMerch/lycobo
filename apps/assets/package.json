{
  "name": "@lycoboai/assets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --config wrangler.local.json --ip 127.0.0.1 --port 8791 --inspector-port 9231 --persist-to ../../.wrangler/state --log-level warn",
