{
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "name": "@lycoboai/api",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "images:provision": "node --env-file-if-exists=../../.env --import tsx scripts/provision-images.ts"
  },
  "dependencies": {
    "hono": "4.13.13",
    "@hono/node-server": "2.1.5",
    "@hono/zod-validator": "0.9.1",
    "pino": "10.4.0",
    "zod": "4.6.7",
    "@lycoboai/contracts": "workspace:*",
    "@lycoboai/db": "workspace:*",
    "@lycoboai/storage": "workspace:*",
    "@lycoboai/generation": "workspace:*",
    "sharp": "0.35.5",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "tsup": "8.5.1"
  }
}
