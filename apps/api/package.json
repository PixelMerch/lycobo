{
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "name": "@lycoboai/api",
  "scripts": {
    "dev": "node --import tsx --watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "images:provision": "node --env-file-if-exists=../../.env --import tsx scripts/provision-images.ts",
    "images:setup": "node --env-file-if-exists=../../.env --import tsx scripts/setup-workbench.ts",
    "auth:account": "node --env-file-if-exists=../../.env --import tsx scripts/enterprise-account.ts",
    "test:auth": "node --env-file-if-exists=../../.env --import tsx scripts/check-auth-integration.ts",
    "test:events": "node --env-file-if-exists=../../.env --import tsx scripts/check-image-events-integration.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/zod-validator": "0.9.1",
    "@lycoboai/billing": "workspace:*",
    "@lycoboai/contracts": "workspace:*",
    "@lycoboai/db": "workspace:*",
    "@lycoboai/generation": "workspace:*",
    "@lycoboai/queue": "workspace:*",
    "@lycoboai/storage": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "hono": "4.13.17",
    "pino": "10.4.0",
    "postgres": "4.1.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsup": "9.0.0",
    "tsx": "4.23.15"
  }
}
