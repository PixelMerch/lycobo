{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lycobo-api",
  "account_id": "9a65fad90669d9c27b58d856ab3ce410",
  "main": "cloudflare/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgresql://lycoboai:local_dev_only@127.0.0.1:55432/lycoboai"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "lycobo"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "queues": {
    "producers": [
      {
        "binding": "GENERATION_QUEUE",
        "queue": "lycobo-generation"
      }
    ]
  },
  "vars": {
    "IMAGE_GENERATION_ENABLED": "false",
    "VAKV_ENABLE_IMAGE_EDITS": "false",
    "AUTH_TRUSTED_ORIGINS": "https://lycobo.pages.dev",
    "APP_ENV": "production"
  }
}
