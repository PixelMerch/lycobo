# Local development only. These credentials must never be used outside localhost.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8787
LOG_LEVEL=info
DATABASE_URL=postgresql://lycoboai:local_dev_only@127.0.0.1:55432/lycoboai

# Supabase is used by local development and explicit remote migrations.
# Fill the URL-encoded database password before starting development.
# Workers use a Hyperdrive binding to this database; DATABASE_URL remains for DB CLI.
# 本地 pnpm dev / docker compose up 也使用此远端库，启动不自动迁移。
SUPABASE_PROJECT_REF=wjirihknptxjodgknbfy
SUPABASE_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.wjirihknptxjodgknbfy.supabase.co:5432/postgres?sslmode=require
# Cloudflare deployment uses only the token and resource identifiers.
# Production runtime variables/secrets are managed in Cloudflare, not this file.
# Create a scoped account API token only when deploying; do not commit it.
CLOUDFLARE_ACCOUNT_ID=9a65fad90669d9c27b58d856ab3ce410
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_HYPERDRIVE_ID=

# Generation stays disabled until bindings, auth, storage and provider are verified.
IMAGE_GENERATION_ENABLED=false
# Wrangler development only: explicitly allow real local provider calls.
LOCAL_IMAGE_GENERATION_ENABLED=false
VAKV_API_KEY=
VAKV_BASE_URL=
GENERATION_TIMEOUT_MS=300000
# Optional Node-only image fixtures; deployed Workers use the private R2 binding.
IMAGE_DATA_DIR=/absolute/path/to/lycobo-image-data
# Internal workspace credits per output, NOT the provider's monetary price.
IMAGE_CREDITS_PER_IMAGE=20
# flare/sunburst have no documented resolutions: leave disabled until provider confirmation.
VAKV_CAPABILITY_OVERRIDES={}
# Enable only after verifying the provider /v1/images/edits contract.
VAKV_ENABLE_IMAGE_EDITS=false
# Provisioning script only: creates a new organization/admin and a 7-day access token.
# IMAGE_ADMIN_SUBJECT=your-existing-auth-subject
# IMAGE_ORGANIZATION_NAME=your-team
# IMAGE_INITIAL_CREDITS=20

# Local workbench cookie identity (NOT the Vakv key). Provision with images:setup; never VITE_*.
IMAGE_WORKBENCH_TOKEN=
IMAGE_WORKBENCH_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
# Five models are routed at 1K by default; 2.5 capabilities require actual provider validation.
# Set VAKV_ENABLE_IMAGE_EDITS=true to use the OpenAI-compatible multipart edit endpoint.

# Enterprise password login / JWT (server only; never use a VITE_ prefix).
# Set a random secret with at least 32 bytes, then apply database migrations.
AUTH_JWT_SECRET=
AUTH_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173
# Administrative provisioning only; do not keep a plaintext password in this file.
# ENTERPRISE_ACCOUNT=
# ENTERPRISE_USER_ID=
# ENTERPRISE_ORGANIZATION_ID=

# Durable task/asset SSE notifications; false falls back to slow polling.
IMAGE_EVENTS_ENABLED=true
