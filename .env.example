# Local development only. These credentials must never be used outside localhost.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8787
LOG_LEVEL=info
DATABASE_URL=postgresql://lycoboai:local_dev_only@127.0.0.1:55432/lycoboai

# Supabase is only used by explicit remote migration/deployment tooling.
# pnpm dev / docker compose up use isolated local PostgreSQL and ignore these credentials.
# Fill the URL-encoded password only when operating on the remote database.
SUPABASE_PROJECT_REF=uyfgzmqijdsesnlsiwqu
SUPABASE_DATABASE_URL=postgresql://postgres.uyfgzmqijdsesnlsiwqu:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# CloudBase private PG storage: backend only; never use VITE_* for these credentials.
# Local development discards all CLOUDBASE_* / TCB_* credentials.
# CLOUDBASE_ENV_ID=lycobo-d9gyvxkegc54a1257
# CLOUDBASE_STORAGE_BUCKET=lycobo-images
# CLOUDBASE_APIKEY=
# GitHub deployment credentials belong in cloudbase-production Environment Secrets:
# TCB_SECRET_ID / TCB_SECRET_KEY (not in frontend configuration).

# Local development reads only the model settings below; business infrastructure remains local.
# Image and video generation are enabled by default; submitted tasks consume provider quota.
# Model management: 32 random bytes encoded as Base64, shared by API and Worker.
# Back up separately; changing this value invalidates existing encrypted credential versions.
MODEL_CREDENTIAL_SECRET=
# Optional local Node image fixtures; remote images use private CloudBase storage.
IMAGE_DATA_DIR=/absolute/path/to/lycobo-image-data

# Provider URL, API key, model, resolutions and timeouts are configured in admin channels.
# Internal workspace credits per output, NOT the provider's monetary price.
IMAGE_CREDITS_PER_IMAGE=20
# Provisioning script only: creates a new organization/admin and a 7-day access token.
# IMAGE_ADMIN_SUBJECT=your-existing-auth-subject
# IMAGE_ORGANIZATION_NAME=your-team
# IMAGE_INITIAL_CREDITS=20

# Local workbench cookie identity (NOT the Vakv key). Provision with images:setup; never VITE_*.
IMAGE_WORKBENCH_TOKEN=
IMAGE_WORKBENCH_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Enterprise password login / JWT (server only; never use a VITE_ prefix).
# Set a random secret with at least 32 bytes, then apply database migrations.
AUTH_JWT_SECRET=
AUTH_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173
# Administrative provisioning only; do not keep a plaintext password in this file.
# ENTERPRISE_ACCOUNT=
# ENTERPRISE_USER_ID=
# ENTERPRISE_ORGANIZATION_ID=

# Durable task/asset SSE notifications; false falls back to slow polling.
IMAGE_EVENTS_ENABLED=true

# Optional S3-compatible backend for isolated development or explicit legacy migration.
# CloudBase configuration takes precedence and never falls back to S3/R2.
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=generated-images
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Never use a public bucket or expose these values through VITE_*.
# Docker dev fixes S3 to the local image-storage service, not these remote settings.

# 主站独立试用模式。Key 仅供 API/消费者服务端使用，禁止 VITE_ 前缀。
STANDALONE_MODELS=false
STANDALONE_IMAGE_API_KEY=
# 新任务启用回调等待；先部署迁移/API 接收端并配置中转站，最后设为 true。
IMAGE_WEBHOOK_ENABLED=false
# 仅 API 端，16–256 字符随机签名密钥；与中转站保持一致。
IMAGE_WEBHOOK_SECRET=
# DeepSeek 官方 Key，仅供服务端 deepseek-flash 生成计划
DEEPSEEK_API_KEY=

# 视频创作默认启用，无独立开关；部署前准备数据库和资源服务。
# 复用 STANDALONE_IMAGE_API_KEY 生图密钥，需具备该视频型号权限。
VIDEO_API_ORIGIN=https://api.uselg.top
# 复用 ASSET_PUBLIC_ORIGIN / ASSET_PATH_PREFIX / ASSET_SIGNING_SECRET。
# 本地带图视频可填指向 8791 资源服务的公网 HTTPS 源站。
# VIDEO_REFERENCE_ORIGIN=
